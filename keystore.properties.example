# ================================================
# keystore.properties — TEMPLATE
# ================================================
# Copy this file to 'keystore.properties' and fill in your values.
# NEVER commit keystore.properties to version control!
#
# To create your keystore, run:
#   keytool -genkeypair -v -keystore draftit-release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias draftit
#
storeFile=../draftit-release.jks
storePassword=YOUR_KEYSTORE_PASSWORD_HERE
keyAlias=draftit
keyPassword=YOUR_KEY_PASSWORD_HERE
